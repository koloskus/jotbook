{
  "description": "Surface the jot and pencil backlogs at session start when they grow past their thresholds.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/backlog-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
